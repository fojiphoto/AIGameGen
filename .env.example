# ── AI ────────────────────────────────────────────────────────────────
# Optional. Without a key the product runs in DETERMINISTIC mode: a rule-based
# planner and refiner replace the model and everything else is identical.
ANTHROPIC_API_KEY=

MODEL_CLASSIFY=claude-haiku-4-5-20251001
MODEL_CONFIG=claude-sonnet-5

# ── Server ────────────────────────────────────────────────────────────
PORT=8787
LOG_LEVEL=warn
# Set to "production" to enable the `secure` flag on session cookies.
# Leave unset locally — localhost is http and secure cookies would never be sent.
NODE_ENV=

# ── Storage ───────────────────────────────────────────────────────────
DB_PATH=data/forge.db
ARTIFACTS_DIR=./artifacts

# ── Seeded admin ──────────────────────────────────────────────────────
# Created on first boot if absent. CHANGE THIS before exposing the server.
ADMIN_EMAIL=admin@factorialstudio.com
ADMIN_PASSWORD=forge-admin-2026

# ── Android toolchain ─────────────────────────────────────────────────
# Auto-detected when already set globally. Latest installed build-tools and
# platform are picked automatically unless pinned here.
JAVA_HOME=C:\dev\java\jdk-21.0.11+10
ANDROID_HOME=C:\dev\Android\Sdk
BUILD_TOOLS_VERSION=
ANDROID_PLATFORM=

# ── Signing ───────────────────────────────────────────────────────────
# A dev keystore is auto-created at android/keys/dev.keystore on first build.
# NEVER ship with it. Production keystores belong in a secret manager, and
# losing one means you can never update a published app again.
KEYSTORE_PATH=
KEYSTORE_PASSWORD=
KEY_ALIAS=forge
KEY_PASSWORD=

# ── Build worker ──────────────────────────────────────────────────────
# Each APK build peaks around 1.5 GB across javac/d8/aapt2, so more
# concurrency on a small machine just causes thrashing.
BUILD_CONCURRENCY=2
