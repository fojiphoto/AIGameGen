node_modules/
dist/
out/
.env
.env.local

# generated artifacts (every one of these is reproducible from a prompt)
artifacts/
artifacts-*/
packages/engine-runner/dist/

# sqlite database (WAL mode creates the -wal/-shm siblings)
data/
*.db
*.db-wal
*.db-shm

# android build output
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/assets/public/
# signing keys must never be committed — losing control of a keystore means anyone can
# ship an update that Android will accept as yours
*.keystore
*.jks
android/keys/

# os
Thumbs.db
.DS_Store

# NeonCoil: the pygbag template cache and Python bytecode are build artefacts. The web build
# under NeonCoil/build/web IS committed, because that is what the arcade page serves.
NeonCoil/build/web-cache/
NeonCoil/build/version.txt
__pycache__/
*.pyc
