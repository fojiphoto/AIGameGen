<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest template. tools/build-apk.mjs substitutes __PACKAGE__, __LABEL__,
  __VERSION_CODE__, __VERSION_NAME__ and __ORIENTATION__ per game.

  Orientation is per-game rather than fixed, because it is not a preference: a 9:16
  game locked to landscape is a tall sliver between two black bars, and a 16:9 game
  locked to portrait is worse. The web build already knows its aspect ratio, so the
  APK build reads it from the same place.

  Note what is ABSENT: there is no <uses-permission> element at all. No INTERNET,
  no storage, nothing. A generated game is fully self-contained, and shipping zero
  permissions is the cleanest possible proof of that to a player looking at the
  install screen.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="__PACKAGE__"
    android:versionCode="__VERSION_CODE__"
    android:versionName="__VERSION_NAME__">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="__LABEL__"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="__ORIENTATION__"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
